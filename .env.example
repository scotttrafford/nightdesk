# NightDesk configuration — copy to .env and fill in.
# Call-flow settings (greetings, phone numbers, timeouts) live in the
# system_config database table, not here.

# ── AI provider ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_api_key_here
# AI_MODEL=claude-sonnet-4-5-20250929
# AI_TIMEOUT_MS=8000          # must stay well under Twilio's 15s webhook timeout
# AI_USE_CACHING=false        # enable at ~10+ calls/hour to cut prompt costs

# ── Twilio ────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TTS_VOICE=Polly.Joanna

# Reject webhooks without a valid X-Twilio-Signature. Keep this on: without it,
# anyone who finds your URL can fake calls (texting staff, revealing numbers).
# Only turn it off briefly for local testing with a URL that changes on restart.
VALIDATE_TWILIO_SIGNATURE=true

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# How the public webhook URL is resolved:
#   direct → BASE_URL (you provide DNS, TLS and a reverse proxy)
#   ngrok  → asks the local ngrok agent (http://127.0.0.1:4040), else NGROK_URL
TUNNEL_MODE=direct
BASE_URL=https://nightdesk.example.com
NGROK_URL=

# systemd unit names used by switch-mode.js
# SERVICE_NAME=nightdesk
# NGROK_SERVICE_NAME=ngrok-tunnel

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nightdesk
DB_USER=nightdesk
DB_PASSWORD=change_me

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                # error | warn | info | debug
LOG_FILE=./logs/app.log
